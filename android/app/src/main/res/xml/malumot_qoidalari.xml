<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutli zaxira va qurilmadan qurilmaga ko'chirishga baza fayli kiradi. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/zikr.sqlite" />
        <include domain="root" path="app_flutter/zikr.sqlite-wal" />
        <include domain="root" path="app_flutter/zikr.sqlite-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/zikr.sqlite" />
        <include domain="root" path="app_flutter/zikr.sqlite-wal" />
        <include domain="root" path="app_flutter/zikr.sqlite-shm" />
    </device-transfer>
</data-extraction-rules>
